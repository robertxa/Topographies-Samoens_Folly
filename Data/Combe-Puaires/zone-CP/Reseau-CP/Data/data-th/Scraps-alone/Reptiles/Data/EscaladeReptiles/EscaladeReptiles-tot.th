survey EscaladeReptiles -title "Escalade des Reptiles"
	input Data/2025-1/EscaladeReptiles2025-tot.th
	input Data/2026-1/EscaladeReptiles2026-tot.th
		equate 10@2026-07-11-EscaladeReptiles.EscaladeReptiles2026 0@PR_reptiles2.EscaladeReptiles2025
		join SP-EscaladeReptiles2026-1@EscaladeReptiles2026 SP-EscReptiles-2@EscaladeReptiles2025
		join SC-EscaladeReptiles2026-1@EscaladeReptiles2026 SC-EscReptiles-1@EscaladeReptiles2025

	input EscaladeReptiles-maps.th

endsurvey