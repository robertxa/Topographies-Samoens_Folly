###############################################################################################
## 2.3 Début de la définition du Layout "layout-kml"                                         ##
###############################################################################################
layout layout-kml
	## Définition du système de projection du plan
	cs EPSG:2154
	## Couleur de la topographie
	## Rouge-Orange = 255,69,0 -->
	## Orange = 255,165,0 -->
	## Orange Sombre = 255,140,0 -->
	## Bleu --> 0, 0 255
	color map-fg [0 0 100]
endlayout

###############################################################################################
## 2.4 Début de la définition du Layout "xviexport"                                          ##
###############################################################################################
layout xviexport
	# cs UTM32
	## Échelle à laquelle on veut dessiner la topo
	scale 1 100
	# scale 1 1000
	## taille de la grille
	grid-size 2 2 2 m
	
	## mettre la grille en arrière plan
	grid bottom
endlayout

## fin de la définition du layout

###############################################################################################
## 3-EXPORT                                                                                  ##
###############################################################################################

## Export des xvi pour le dessin si besoin
	# export map -proj plan -layout xviexport -fmt xvi -o Data/CD1-Plan.xvi
	# export map -proj extended -layout xviexport -fmt xvi -o Data/CD1-Extended.xvi

## Sélection des Maps à exporter
	select MP-CD1-tot@CD1
	select MC-CD1-tot@CD1

## Export des fichiers pdf, plan et coupe.
## ATTENTION, la topo étant énorme, il faut mettre l'option ne traçant pas la centerline !
	export map -projection plan     -fmt pdf -layout layout-Plan -o Outputs/CD1-Plan.pdf
	export map -projection extended -fmt pdf -layout layout-Extended -o Outputs/CD1-Extended.pdf

## Export du fichier 3d pour Loch
	export model -enable all -o Outputs/CD1.lox
	# export model -enable all -o Outputs/CD1.kml
	# export model -enable all -o Outputs/CD1.plt

## Export des fichiers ESRI
	# export map -proj plan -fmt esri -o Outputs/CD1
	# export model -fmt esri -o Outputs/SHP/therion -enc UTF-8

## Autres exports
	# export map -proj plan -fmt kml -o Outputs/CD1.kml -layout layout-kml
	# export model -fmt kml -o Outputs/CD1-model.kml -enable all
	# export model -enable all -o Outputs/CD1-3D.kml
	export cave-list -surveys off -location on -o Outputs/CD1_Cave-list.html
	export cave-list -surveys off -location on -o Outputs/CD1_Cave-list.txt
	export survey-list -location on -o Outputs/CD1-Surveys.html
	# export database -fmt sql -o Outputs/CD1-Database.sql
	# export continuation-list -o Outputs/CD1-Continuations.html



