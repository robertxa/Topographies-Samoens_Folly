		\newtoks\explodepthtitle \explodepthtitle{\thinspace{}---\thinspace{}\thinspace{}\thinspace{}\thinspace{}Profondeur explorée }
		\newtoks\cavelengthtitle \cavelengthtitle{Développement }
		\newtoks\cavedepthtitle \cavedepthtitle{dénivellation }
		\newtoks\depthrangetitle \depthrangetitle{altitudes }
	endcode
	
