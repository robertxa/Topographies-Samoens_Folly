	break
	#SP-PuitsSolitarises-3	# Pas à représenter, c'est fait en fait dans le SP-PuitsSolitarises-2
	#break
	SP-PuitsSolitarises-1
	break
	SP-PuitsSolitarises-2
	break
	SP-PuitsSolitarises2023-1
	break
	SP-PuitsSolitarises2023-2
	break
	SP-PuitsSolitarises2023-3
	break
	SP-PuitsSolitarises2023-4
	break
	SP-PuitsSolitarises2023b-1
	break
	SP-PuitsSolitarises2023b-2
	break
	SP-PuitsSolitarises2023b-3
	
	break
	SP-Etancheur-1
	break
	SP-Kissikol-1
	break
	SP-ShuntSoif-1
	break

	SP-PuitsSolitarises2023b-4
	break
	SP-PuitsSolitarises2023b-5
	break
	SP-PuitsSolitarises2023b-6
	break
	SP-PuitsSolitarises2023b-7
	break
	SP-PuitsSolitarises2023b-9
	break
	SP-PuitsSolitarises2023b-8

	#break
	#SP-SoifInf-1
	#break
	#SP-SoifInf-3
	#break
	#SP-SoifInf-2

endmap

map MP-SoifInf
	SP-SoifInf-1
	break
	SP-SoifInf-3
	break
	SP-SoifInf-2
endmap

map MP-PuitsSolitarises -title "Réseau des Solitarisés"
	MP-PuitsPuitsSolitarises
	break
	MP-SoifInf [0 -25 m] below
endmap


