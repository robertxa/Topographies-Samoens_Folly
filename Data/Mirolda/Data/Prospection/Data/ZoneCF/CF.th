survey trousCF -title "trous CF"

# Fichier contenant les positions des entrées de la zone AV, Samoens, France

 centerline
cs lat-long

fix CF10    46.09143    6.7901  2274
station   CF10       "CF10" entrance continuation explored 50m # Réserve de glace, Cordes, F230 15 m au dessus

cs EPSG:2154
#fix CF10b   46.09192    6.78976 2285
fix CF10b 992702.85	6561703.29	2285    
station   CF10b       "CF10b" entrance # Puits de 13 m
    data normal from to length  compass clino   #left    right   up  down
    CF10b    CF10bb   0   0   0   #0.5 0.7 0   4
    CF10b    CF10b-1  13   0   -90 #0.5 0.7 4   0   # colm


cs EPSG:27572 # LII Etendu

fix       CF1       944240     2130980     2260
###fix       CF2       944120     2130200     2100
fix       CF3       944140     2130630     2200
fix       CF4       944230     2130720     2240
###fix       CF5       944490     2130940     2340
###fix       CF6       944530     2130940     2345
###fix       CF6       944490     2130980     2350 # Data Colliard - Spelealpes 08

cs UTM32
fix       CF5       329424  5106499     2328    # GPS 2023 + Lidar IGN
fix       CF6       329457  5106501     2331    # GPS 2023 + Lidar IGN

station   CF1       "CF1" entrance #air-draught continuation explored 28m
###station   CF2       "CF2" entrance air-draught continuation explored 28m
station   CF3       "CF3" entrance #air-draught continuation explored 28m
station   CF4       "CF4/F105" entrance continuation explored 70m
station   CF5       "CF5" entrance air-draught #continuation explored 28m
###station   CF6       "CF6" entrance #air-draught #continuation explored 28m
station   CF6       "CF6" entrance continuation explored 447m #profondeur -140 m

endcenterline

endsurvey